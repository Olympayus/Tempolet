  "fixed_sql": [
    {
      "name": "events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"events\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"note\" TEXT NOT NULL DEFAULT '', \"category_id\" TEXT NULL, \"kind\" TEXT NOT NULL, \"date\" INTEGER NOT NULL, \"start_minute\" INTEGER NULL, \"end_minute\" INTEGER NULL, \"importance\" INTEGER NOT NULL DEFAULT 0, \"reminder_offset_minutes\" INTEGER NULL, \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), \"completed_at\" INTEGER NULL, \"notification_id\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "holidays",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"holidays\" (\"date\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"is_workday\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_workday\" IN (0, 1)), \"source\" TEXT NOT NULL DEFAULT 'seed', \"updated_at\" INTEGER NULL, PRIMARY KEY (\"date\"));"
        }
      ]
    },
    {
      "name": "notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notes\" (\"id\" TEXT NOT NULL, \"short_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"format\" TEXT NOT NULL, \"relative_path\" TEXT NOT NULL, \"file_mtime\" INTEGER NOT NULL, \"file_size\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "note_event_links",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"note_event_links\" (\"id\" TEXT NOT NULL, \"note_id\" TEXT NOT NULL, \"event_id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
